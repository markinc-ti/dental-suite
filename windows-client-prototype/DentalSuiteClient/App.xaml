<Application x:Class="DentalSuiteClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DentalSuiteClient.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:DentitionTypeConverter x:Key="DentitionConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <conv:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter"/>
    </Application.Resources>
</Application>
