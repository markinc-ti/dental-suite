<Window x:Class="DentalSuiteClient.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dental Suite — Calendario de citas" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen" Icon="tooth.ico">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#8A1538" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Calendario de citas" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Navegación de mes -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Mes anterior" Padding="10,6" Click="OnPreviousMonthClick"/>
            <TextBlock Grid.Column="1" x:Name="MonthTitleText" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Mes siguiente →" Padding="10,6" Click="OnNextMonthClick"/>
        </Grid>

        <!-- Cuadrícula del mes (izquierda, con su propio encabezado de días
             adentro para garantizar que las columnas coincidan exactamente)
             + detalle del día seleccionado (derecha) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="DOM" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="LUN" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="MAR" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="MIÉ" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="JUE" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="VIE" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="SÁB" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                </UniformGrid>

                <Grid x:Name="MonthGrid"/>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="SelectedDayText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="Nueva cita" Height="30" Margin="0,0,0,4" Click="OnNewAppointmentClick"/>
                <TextBlock Text="(Doble clic en una cita para editarla)" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>
                <ListBox x:Name="SelectedDayList" MouseDoubleClick="OnSelectedDayItemDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding TimeRangeText}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PatientName}"/>
                                <TextBlock Text="{Binding DoctorName}" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding Reason}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
