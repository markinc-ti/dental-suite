<Window x:Class="DentalSuiteClient.CameraCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captura de cámara intraoral" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" WindowState="Normal">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Vista previa en vivo — acomoda la cámara y presiona Guardar"
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Width="110" Height="34" Click="OnCancelClick"/>
            <Button Content="Guardar" Width="110" Height="34" Margin="8,0,0,0" Click="OnSaveClick"/>
        </StackPanel>

        <Border Background="Black" BorderBrush="Gray" BorderThickness="1">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
        </Border>
    </DockPanel>
</Window>
