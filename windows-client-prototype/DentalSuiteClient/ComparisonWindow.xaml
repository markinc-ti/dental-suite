<Window x:Class="DentalSuiteClient.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparación de imágenes" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Comparación" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Name="LeftLabel" Text="Diente: —" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="Elegir imagen" Margin="12,0,0,0" Padding="8,4" Click="OnChooseLeftClick"/>
                </StackPanel>
                <Border Background="Black" BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="LeftImage" Stretch="Uniform"/>
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Name="RightLabel" Text="Diente: —" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="Elegir imagen" Margin="12,0,0,0" Padding="8,4" Click="OnChooseRightClick"/>
                </StackPanel>
                <Border Background="Black" BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="RightImage" Stretch="Uniform"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
