<Window x:Class="DentalSuiteClient.EditAppointmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar cita" Height="420" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinHeight="380" MinWidth="340" Icon="tooth.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="30" Click="OnCancelClick"/>
            <Button Content="Guardar" Width="90" Height="30" Margin="8,0,0,0" Click="OnSaveClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="PatientText" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

                <TextBlock Text="Doctor"/>
                <ComboBox x:Name="DoctorComboBox" Height="28" Margin="0,4,0,10" DisplayMemberPath="FullName"/>

                <TextBlock Text="Fecha"/>
                <DatePicker x:Name="DatePickerControl" Margin="0,4,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hora inicio (HH:mm)"/>
                        <TextBox x:Name="StartTimeBox" Height="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duración (minutos)"/>
                        <TextBox x:Name="DurationBox" Height="28"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Motivo"/>
                <TextBox x:Name="ReasonBox" Height="28" Margin="0,4,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
