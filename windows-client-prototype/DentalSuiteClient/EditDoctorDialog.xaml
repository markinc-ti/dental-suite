<Window x:Class="DentalSuiteClient.EditDoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar doctor" Height="400" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinHeight="360" MinWidth="340" Icon="tooth.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="30" Click="OnCancelClick"/>
            <Button Content="Guardar" Width="90" Height="30" Margin="8,0,0,0" Click="OnSaveClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre completo"/>
                <TextBox x:Name="FullNameBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Text="Usuario (correo o teléfono, no se puede cambiar aquí)"/>
                <TextBox x:Name="UsernameBox" Height="28" Margin="0,4,0,10" IsEnabled="False"/>

                <TextBlock Text="Teléfono"/>
                <TextBox x:Name="PhoneBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Text="Especialidad"/>
                <TextBox x:Name="SpecialtyBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Text="Cédula profesional / Número de certificado"/>
                <TextBox x:Name="LicenseBox" Height="28" Margin="0,4,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
