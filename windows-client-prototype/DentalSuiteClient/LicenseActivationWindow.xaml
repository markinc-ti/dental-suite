<Window x:Class="DentalSuiteClient.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activar Dental Suite" Height="380" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        MinHeight="320" MinWidth="420" Icon="tooth.ico">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Salir" Width="90" Height="30" Click="OnExitClick"/>
            <Button Content="Activar" Width="90" Height="30" Margin="8,0,0,0" Click="OnActivateClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dental Suite" FontSize="22" FontWeight="Bold" Foreground="#8A1538"/>
                <TextBlock Text="Este equipo todavía no tiene una licencia activa."
                           TextWrapping="Wrap" Margin="0,8,0,20"/>

                <TextBlock Text="Ingresa tu llave de licencia:"/>
                <TextBox x:Name="LicenseKeyBox" Height="60" Margin="0,6,0,6"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
