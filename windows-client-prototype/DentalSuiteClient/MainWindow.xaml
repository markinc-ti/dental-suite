<Window x:Class="DentalSuiteClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dental Suite" Height="800" Width="1300"
        Background="#F0F0F0" Icon="tooth.ico">

    <Window.Resources>
        <Style x:Key="ThumbBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Forma de "diente": más redondeado abajo (raíz) que arriba
             (corona), simple pero reconocible como diente sin necesitar
             gráficos externos. Cambia de color cuando está seleccionado. -->
        <Style x:Key="ToothToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border CornerRadius="6,6,16,16" BorderThickness="1.5" BorderBrush="#999999">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#BEE3D4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Barra superior: datos del paciente -->
        <Border DockPanel.Dock="Top" Background="#8A1538" Padding="8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nombre:" Foreground="White" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding PatientName}" Foreground="White" Margin="0,0,20,0"/>
                    <TextBlock Text="ID:" Foreground="White" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding PatientId}" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Historial" Padding="10,4" Margin="0,0,8,0" Click="OnViewHistoryClick"/>
                    <Button Content="Nuevo odontograma" Padding="10,4" Margin="0,0,8,0" Click="OnNewOdontogramClick"/>
                    <Button Content="Comparar" Padding="10,4" Margin="0,0,8,0" Click="OnCompareClick"/>
                    <Button Content="← Volver a pacientes" Padding="10,4" Click="OnBackToPatientsClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Zona superior: odontograma ============ -->
            <Border Grid.Row="0" Margin="10" Padding="14" Background="#1B1F23">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <!-- Fila superior: números arriba de cada diente -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock Text="DCH" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ItemsControl ItemsSource="{Binding UpperRightTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayNumber}" Foreground="#4FA3D9"
                                                   Width="30" TextAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Fill="#555555" Margin="6,0"/>
                            <ItemsControl ItemsSource="{Binding UpperLeftTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayNumber}" Foreground="#4FA3D9"
                                                   Width="30" TextAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="IZQ" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Fila superior: los dientes en sí -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Width="35"/>
                            <ItemsControl ItemsSource="{Binding UpperRightTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ToothToggleStyle}"
                                                      IsChecked="{Binding IsSelected}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Fill="#555555" Margin="6,0"/>
                            <ItemsControl ItemsSource="{Binding UpperLeftTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ToothToggleStyle}"
                                                      IsChecked="{Binding IsSelected}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Width="35"/>
                        </StackPanel>

                        <!-- Fila inferior: los dientes primero, números después (abajo) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock Width="35"/>
                            <ItemsControl ItemsSource="{Binding LowerRightTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ToothToggleStyle}"
                                                      IsChecked="{Binding IsSelected}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Fill="#555555" Margin="6,0"/>
                            <ItemsControl ItemsSource="{Binding LowerLeftTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ToothToggleStyle}"
                                                      IsChecked="{Binding IsSelected}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Width="35"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="DCH" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ItemsControl ItemsSource="{Binding LowerRightTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayNumber}" Foreground="#4FA3D9"
                                                   Width="30" TextAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Fill="#555555" Margin="6,0"/>
                            <ItemsControl ItemsSource="{Binding LowerLeftTeeth}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayNumber}" Foreground="#4FA3D9"
                                                   Width="30" TextAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="IZQ" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Adulto / Infantil -->
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <RadioButton GroupName="Dentition" Margin="0,0,0,16" HorizontalAlignment="Center"
                                     IsChecked="{Binding DentitionType, Converter={StaticResource DentitionConverter}, ConverterParameter=Permanent}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🧑" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="Adulto" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Dentition" HorizontalAlignment="Center"
                                     IsChecked="{Binding DentitionType, Converter={StaticResource DentitionConverter}, ConverterParameter=Deciduous}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👶" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="Infantil" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Zona inferior: casillas de captura (radiografía y foto por diente) ============ -->
            <Border Grid.Row="1" Margin="10" Padding="10" Background="Black">
                <Grid>
                    <TextBlock Text="Selecciona uno o más dientes arriba: aparecerán aquí sus casillas de radiografía, foto y video, listas para capturar."
                               Foreground="Gray" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding CaptureSlots.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CaptureSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ThumbBorderStyle}"
                                        MouseLeftButtonDown="OnThumbnailMouseLeftButtonDown">
                                    <Grid>
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"
                                               Visibility="{Binding IsCaptured, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding DisplayNumber}" Foreground="White"
                                                   FontWeight="Bold" Margin="4"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                Visibility="{Binding IsCaptured, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Click="OnDeleteSlotClick"/>
                                        <Border Background="#B0000000" VerticalAlignment="Bottom" Padding="2">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                                                       FontSize="10" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </Border>

        </Grid>
    </DockPanel>
</Window>
