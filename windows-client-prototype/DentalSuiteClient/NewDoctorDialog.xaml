<Window x:Class="DentalSuiteClient.NewDoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo doctor" Height="490" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Nombre completo"/>
        <TextBox x:Name="FullNameBox" Height="28" Margin="0,4,0,10"/>

        <TextBlock Text="Correo o teléfono (será su usuario)"/>
        <TextBox x:Name="UsernameBox" Height="28" Margin="0,4,0,10"/>

        <TextBlock Text="Contraseña"/>
        <PasswordBox x:Name="PasswordBox" Height="28" Margin="0,4,0,10"/>

        <TextBlock Text="Teléfono"/>
        <TextBox x:Name="PhoneBox" Height="28" Margin="0,4,0,10"/>

        <TextBlock Text="Especialidad"/>
        <TextBox x:Name="SpecialtyBox" Height="28" Margin="0,4,0,10"/>

        <TextBlock Text="Cédula profesional / Número de certificado"/>
        <TextBox x:Name="LicenseBox" Height="28" Margin="0,4,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Height="30" Click="OnCancelClick"/>
            <Button Content="Guardar" Width="90" Height="30" Margin="8,0,0,0" Click="OnSaveClick"/>
        </StackPanel>
    </StackPanel>
</Window>
