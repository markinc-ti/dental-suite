<Window x:Class="DentalSuiteClient.NewTreatmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo tratamiento" Height="640" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinHeight="500" MinWidth="400" Icon="tooth.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="30" Click="OnCancelClick"/>
            <Button Content="Crear" Width="90" Height="30" Margin="8,0,0,0" Click="OnCreateClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Buscar paciente"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBox x:Name="SearchBox" Width="220" Height="28" KeyUp="OnSearchKeyUp"/>
                    <Button Content="Buscar" Width="80" Height="28" Margin="8,0,0,0" Click="OnSearchClick"/>
                </StackPanel>
                <ListBox x:Name="PatientList" Height="80" DisplayMemberPath="FullName" Margin="0,0,0,12"/>

                <TextBlock Text="Doctor"/>
                <ComboBox x:Name="DoctorComboBox" Height="28" Margin="0,4,0,12" DisplayMemberPath="FullName"/>

                <TextBlock Text="Tipo de tratamiento (del catálogo, opcional)"/>
                <ComboBox x:Name="TreatmentTypeComboBox" Height="28" Margin="0,4,0,12"
                          DisplayMemberPath="Name" SelectionChanged="OnTreatmentTypeSelected"/>

                <TextBlock Text="Nombre del tratamiento"/>
                <TextBox x:Name="NameBox" Height="28" Margin="0,4,0,12"/>

                <TextBlock Text="Costo estimado"/>
                <TextBox x:Name="CostBox" Height="28" Margin="0,4,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Número de sesiones"/>
                        <TextBox x:Name="SessionCountBox" Height="28" Text="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cada cuántos días"/>
                        <TextBox x:Name="IntervalDaysBox" Height="28" Text="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Fecha de la primera sesión"/>
                <DatePicker x:Name="StartDatePicker" Margin="0,4,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hora (HH:mm)"/>
                        <TextBox x:Name="StartTimeBox" Height="28" Text="10:00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duración por sesión (min)"/>
                        <TextBox x:Name="DurationBox" Height="28" Text="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Notas (opcional)"/>
                <TextBox x:Name="NotesBox" Height="60" Margin="0,4,0,4"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
