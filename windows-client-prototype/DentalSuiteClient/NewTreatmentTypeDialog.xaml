<Window x:Class="DentalSuiteClient.NewTreatmentTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo tipo de tratamiento" Height="480" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinHeight="420" MinWidth="340" Icon="tooth.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="30" Click="OnCancelClick"/>
            <Button Content="Guardar" Width="90" Height="30" Margin="8,0,0,0" Click="OnSaveClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre"/>
                <TextBox x:Name="NameBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Text="Descripción (opcional)"/>
                <TextBox x:Name="DescriptionBox" Height="60" Margin="0,4,0,10"
                         TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Número de sesiones por defecto"/>
                <TextBox x:Name="SessionCountBox" Height="28" Text="1" Margin="0,4,0,10"/>

                <TextBlock Text="Intervalo entre sesiones (días)"/>
                <TextBox x:Name="IntervalDaysBox" Height="28" Text="30" Margin="0,4,0,10"/>

                <TextBlock Text="Costo por defecto (opcional)"/>
                <TextBox x:Name="CostBox" Height="28" Margin="0,4,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
