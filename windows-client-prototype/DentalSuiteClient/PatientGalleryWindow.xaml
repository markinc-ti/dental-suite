<Window x:Class="DentalSuiteClient.PatientGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radiografías y fotos del paciente" Height="600" Width="850"
        WindowStartupLocation="CenterScreen" Icon="tooth.ico">
    <DockPanel Margin="12">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <Button DockPanel.Dock="Bottom" Content="Cerrar" Width="90" Height="30"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnCloseClick"/>

        <TextBlock x:Name="EmptyText" Text="Este paciente todavía no tiene ninguna imagen capturada."
                   Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ImagesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Height="190" Margin="6" Background="Black"
                                BorderBrush="Gray" BorderThickness="1" MouseLeftButtonUp="OnImageClick" Tag="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Caption}"
                                           Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="2"/>
                                <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="Uniform"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
