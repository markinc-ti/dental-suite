<Window x:Class="DentalSuiteClient.PickDateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir fecha" Height="280" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="tooth.ico">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="Fecha"/>
        <DatePicker x:Name="DatePickerControl" Margin="0,4,0,10"/>

        <TextBlock Text="Hora (HH:mm)"/>
        <TextBox x:Name="TimeBox" Height="28" Text="10:00" Margin="0,4,0,10"/>

        <TextBlock x:Name="NotesLabel" Text="Notas (opcional)"/>
        <TextBox x:Name="NotesBox" Height="50" Margin="0,4,0,12"
                 TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Height="30" Click="OnCancelClick"/>
            <Button Content="Guardar" Width="90" Height="30" Margin="8,0,0,0" Click="OnSaveClick"/>
        </StackPanel>
    </StackPanel>
</Window>
