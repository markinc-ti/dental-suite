<Window x:Class="DentalSuiteClient.SensorCaptureStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturando"
        Width="420" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusText"
                       Text="Esperando disparo de rayos X..."
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,16" />
            <ProgressBar IsIndeterminate="True" Height="6" Width="280" />
        </StackPanel>

        <Button Grid.Row="1" Content="Cancelar" HorizontalAlignment="Center"
                Padding="16,4" Click="OnCancelClick" />
    </Grid>
</Window>
