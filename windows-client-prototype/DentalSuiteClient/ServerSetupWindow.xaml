<Window x:Class="DentalSuiteClient.ServerSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dental Suite — Configurar servidor" Height="480" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        MinHeight="340" MinWidth="400" Icon="tooth.ico">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom">
            <Button Content="Conectar" Height="32" Click="OnConnectClick"/>
            <TextBlock Text="— o —" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,10"/>
            <Button Content="Usar solo esta computadora (sin conectar celular ni otra PC)"
                    Height="36" Click="OnLocalModeClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dental Suite" FontSize="22" FontWeight="Bold" Foreground="#8A1538"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,20"
                           Text="¿Vas a consultar Dental Suite desde el celular u otra computadora? Conéctalo a un servidor. Si solo lo vas a usar aquí, puedes trabajar sin configurar nada."/>

                <TextBlock Text="Dirección del servidor"/>
                <TextBox x:Name="ServerUrlBox" Height="28" Margin="0,4,0,4"
                         Text="https://"/>
                <TextBlock Text="Ejemplo: https://dental-suite-xxxx.onrender.com"
                           Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>

                <TextBlock x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
