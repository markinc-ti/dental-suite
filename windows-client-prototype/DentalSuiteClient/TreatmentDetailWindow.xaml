<Window x:Class="DentalSuiteClient.TreatmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del tratamiento" Height="560" Width="600"
        WindowStartupLocation="CenterScreen" Icon="tooth.ico">
    <DockPanel Margin="16">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubtitleText" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock x:Name="ProgressText" FontWeight="Bold" Margin="0,0,0,4"/>
            <ProgressBar x:Name="ProgressBarControl" Height="20"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Cancelar tratamiento" Height="30" Click="OnCancelTreatmentClick"/>
            <Button Content="Cerrar" Width="90" Height="30" Margin="8,0,0,0" Click="OnCloseClick"/>
        </StackPanel>

        <Button DockPanel.Dock="Top" Content="+ Agregar sesión extra" Height="30" HorizontalAlignment="Left"
                Margin="0,0,0,10" Click="OnAddExtraSessionClick"/>

        <ListView x:Name="SessionsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding SessionNumber}"/>
                    <GridViewColumn Header="Fecha" Width="140" DisplayMemberBinding="{Binding ScheduledDateText}"/>
                    <GridViewColumn Header="Estado" Width="110" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Reprogramar" Padding="6,2"
                                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="OnRescheduleSessionClick" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Marcar completada" Padding="6,2"
                                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="OnCompleteSessionClick" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
